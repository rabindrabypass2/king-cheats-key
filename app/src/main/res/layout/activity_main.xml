<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#1F1F1F"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="King Cheats Key App"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Key Generator System"
                android:textColor="#00E676"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTelegramTop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Telegram"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#0088CC"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reload"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#333333"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone"
        android:progressTint="#00E676" />

    <!-- Main WebView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay when locked -->
        <LinearLayout
            android:id="@+id/lockOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121212"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Channel Verification Required"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You must join our official Telegram channel to get the key and access this application."
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnJoinTelegramOverlay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="1. Join Official Telegram"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="#0088CC"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnVerifyJoined"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="2. I Have Joined (Unlock App)"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="#00E676"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnExitApp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Exit Application"
                android:textSize="13sp"
                android:textColor="#FF5252"
                android:background="#222222" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
