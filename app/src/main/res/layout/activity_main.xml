<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full Screen Main WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Thin Top Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:visibility="gone"
        android:progressTint="#00E676" />

    <!-- AXA MOD Custom Dialog Overlay Matching Screenshot -->
    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <!-- Centered Red Bordered Card -->
        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/dialog_card_bg"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp"
            android:gravity="center">

            <!-- Title: AXA MOD in red bold -->
            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AXA MOD"
                android:textColor="#C62828"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="24dp" />

            <!-- JOINED Button (Green Pill) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnJoined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_joined_bg"
                android:text="JOINED"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <!-- JOIN CHANNEL Button (Blue Pill) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnJoinChannel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_channel_bg"
                android:text="JOIN CHANNEL"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
